---
interface Project {
  title: string;
  date: string;
  type?: string;
  description: string;
  preview?: string;
  whatIs?: string;
  whyBuilt?: string;
  technicalDescription?: string;
  demo?: string;
  demoIsVideo?: boolean;
  demoAlt?: string;
  externalLink?: string;
  linkType?: 'url' | 'file';
  linkText?: string;
}

interface Props {
  config: {
    title: string;
    projects: Project[];
  };
}

const { config } = Astro.props;
---

<section id="projects" class="scroll-mt-24 py-20">
  <!-- Section header -->
  <div class="mb-12">
    <p class="mb-2 text-xs font-semibold uppercase tracking-widest text-brand-400">What I've built</p>
    <h2 class="text-3xl font-bold tracking-tight text-white md:text-4xl">{config.title}</h2>
  </div>

  <div class="grid gap-4 sm:grid-cols-2 md:grid-cols-3">
    {
      config.projects.map((project) => (
        <button
          class="project-btn group relative flex flex-col overflow-hidden rounded-2xl border border-white/8 bg-neutral-900/50 text-left backdrop-blur-sm transition-all duration-300 hover:border-white/15 hover:shadow-xl hover:shadow-brand-500/5 cursor-pointer"
          data-project={JSON.stringify(project)}
          type="button"
        >
          {/* Preview image strip if available */}
          {project.preview && (
            <div class="relative h-32 w-full overflow-hidden">
              <img
                src={project.preview}
                alt={`${project.title} preview`}
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-b from-transparent via-neutral-950/20 to-neutral-950/80" />
            </div>
          )}

          <div class="flex flex-1 flex-col p-5">
            <h3 class="mb-2 text-sm font-semibold text-white">{project.title}</h3>
            <div class="mb-3 flex flex-wrap gap-x-3 gap-y-1">
              <span class="text-xs text-neutral-500">{project.date}</span>
              {project.type && (
                <span class="text-xs font-medium text-neutral-600">{project.type}</span>
              )}
            </div>
            <p class="text-xs leading-5 text-neutral-400">{project.description}</p>
          </div>
        </button>
      ))
    }
  </div>
</section>

<!-- Project popup -->
<div
  id="project-overlay"
  class="fixed inset-0 z-50 hidden items-center justify-center overflow-y-auto bg-black/70 p-4 backdrop-blur-sm"
  role="dialog"
  aria-modal="true"
  aria-labelledby="project-popup-title"
>
  <div
    id="project-popup"
    class="relative my-auto w-full max-w-2xl overflow-hidden rounded-2xl border border-white/10 bg-neutral-900 shadow-2xl"
    style="opacity:0;transform:scale(0.95) translateY(8px);transition:opacity 0.2s ease-out,transform 0.2s ease-out"
  >
    <!-- Top gradient bar -->
    <div class="h-px w-full bg-gradient-to-r from-transparent via-brand-500/50 to-transparent"></div>

    <div class="p-6 md:p-8">
      <button
        id="project-popup-close"
        class="absolute right-4 top-4 rounded-lg p-1 text-neutral-500 transition-colors hover:bg-white/5 hover:text-white"
        aria-label="Close"
        type="button"
      >
        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"
          ></path>
        </svg>
      </button>

      <h2 id="project-popup-title" class="mb-1 pr-8 text-2xl font-bold text-white"></h2>
      <p id="project-popup-date" class="mb-6 text-sm text-neutral-500"></p>

      <div class="space-y-5">
        <div id="project-popup-whatis" class="hidden">
          <h3 class="mb-2 text-sm font-semibold uppercase tracking-wider text-brand-400">
            What is this project?
          </h3>
          <p id="project-popup-whatis-text" class="text-sm leading-7 text-neutral-300"></p>
        </div>

        <div id="project-popup-why" class="hidden">
          <h3 class="mb-2 text-sm font-semibold uppercase tracking-wider text-brand-400">
            Why built this?
          </h3>
          <p id="project-popup-why-text" class="text-sm leading-7 text-neutral-300"></p>
        </div>

        <div id="project-popup-tech" class="hidden">
          <h3 class="mb-2 text-sm font-semibold uppercase tracking-wider text-brand-400">
            Technical Details
          </h3>
          <p id="project-popup-tech-text" class="text-sm leading-7 text-neutral-300"></p>
        </div>

        <div id="project-popup-demo" class="hidden">
          <h3 class="mb-3 text-sm font-semibold uppercase tracking-wider text-brand-400">Demo</h3>
          <video
            id="project-popup-video"
            class="hidden w-full rounded-xl"
            controls
          ></video>
          <img
            id="project-popup-image"
            src=""
            alt=""
            class="hidden w-full rounded-xl object-cover"
            loading="lazy"
          />
        </div>

        <div id="project-popup-link" class="hidden pt-2">
          <a
            id="project-popup-btn"
            href="#"
            class="inline-flex items-center gap-1.5 text-sm font-medium text-neutral-400 transition-colors duration-200 hover:text-white"
            target="_blank"
            rel="noopener noreferrer"
          ></a>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  interface Project {
    title: string;
    date: string;
    whatIs?: string;
    whyBuilt?: string;
    technicalDescription?: string;
    demo?: string;
    demoIsVideo?: boolean;
    demoAlt?: string;
    externalLink?: string;
    linkType?: 'url' | 'file';
    linkText?: string;
  }

  const overlay = document.getElementById('project-overlay')!;
  const popup = document.getElementById('project-popup')!;
  const closeBtn = document.getElementById('project-popup-close')!;

  function el(id: string) {
    return document.getElementById(id)!;
  }

  function setSection(sectionId: string, textId: string, value?: string) {
    const section = el(sectionId);
    if (value) {
      el(textId).textContent = value;
      section.classList.remove('hidden');
    } else {
      section.classList.add('hidden');
    }
  }

  function openPopup(project: Project) {
    el('project-popup-title').textContent = project.title;
    el('project-popup-date').textContent = project.date;

    setSection('project-popup-whatis', 'project-popup-whatis-text', project.whatIs);
    setSection('project-popup-why', 'project-popup-why-text', project.whyBuilt);
    setSection('project-popup-tech', 'project-popup-tech-text', project.technicalDescription);

    const demoSection = el('project-popup-demo');
    const video = el('project-popup-video') as HTMLVideoElement;
    const image = el('project-popup-image') as HTMLImageElement;

    if (project.demo) {
      demoSection.classList.remove('hidden');
      if (project.demoIsVideo) {
        video.src = project.demo;
        video.classList.remove('hidden');
        image.classList.add('hidden');
      } else {
        image.src = project.demo;
        image.alt = project.demoAlt ?? `${project.title} demo`;
        image.classList.remove('hidden');
        video.classList.add('hidden');
      }
    } else {
      demoSection.classList.add('hidden');
    }

    const linkSection = el('project-popup-link');
    const linkBtn = el('project-popup-btn') as HTMLAnchorElement;

    if (project.externalLink) {
      linkSection.classList.remove('hidden');
      linkBtn.textContent = project.linkText ?? 'View';
      linkBtn.href = project.externalLink;
      if (project.linkType === 'file') {
        linkBtn.removeAttribute('target');
        linkBtn.removeAttribute('rel');
        linkBtn.onclick = (e) => {
          e.preventDefault();
          window.open(project.externalLink);
        };
      } else {
        linkBtn.target = '_blank';
        linkBtn.rel = 'noopener noreferrer';
        linkBtn.onclick = null;
      }
    } else {
      linkSection.classList.add('hidden');
    }

    overlay.classList.remove('hidden');
    overlay.classList.add('flex');
    document.body.style.overflow = 'hidden';
    requestAnimationFrame(() => {
      popup.style.opacity = '1';
      popup.style.transform = 'scale(1) translateY(0)';
    });
  }

  function closePopup() {
    popup.style.opacity = '0';
    popup.style.transform = 'scale(0.95) translateY(8px)';
    const video = el('project-popup-video') as HTMLVideoElement;
    video.pause();
    setTimeout(() => {
      overlay.classList.add('hidden');
      overlay.classList.remove('flex');
    }, 200);
    document.body.style.overflow = '';
  }

  closeBtn.addEventListener('click', closePopup);
  overlay.addEventListener('click', (e) => {
    if (e.target === overlay) closePopup();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && overlay.classList.contains('flex')) closePopup();
  });

  document.querySelectorAll<HTMLButtonElement>('.project-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const project = JSON.parse(btn.dataset.project ?? '{}') as Project;
      openPopup(project);
    });
  });
</script>
