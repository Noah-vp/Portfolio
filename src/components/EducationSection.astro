---
interface Education {
  title: string;
  institution: string;
  date: string;
  description: string;
}

interface Props {
  config: {
    title: string;
    educations: Education[];
  };
}

const { config } = Astro.props;
---

<section id="education" class="scroll-mt-24 py-20">
  <!-- Section header -->
  <div class="mb-12">
    <p class="mb-2 text-xs font-semibold uppercase tracking-widest text-brand-400">My background</p>
    <h2 class="text-3xl font-bold tracking-tight text-white md:text-4xl">{config.title}</h2>
  </div>

  <!-- Timeline -->
  <div class="relative pl-6">
    <div
      class="absolute left-0 top-2 h-[calc(100%-2rem)] w-px bg-gradient-to-b from-brand-500/60 via-brand-500/20 to-transparent"
    ></div>

    <div class="flex flex-col gap-8">
      {
        config.educations.map((edu, i) => (
          <div class="group relative">
            <div
              class={`absolute -left-[25px] top-5 h-3 w-3 rounded-full border-2 border-brand-500 bg-neutral-950 transition-all duration-300 group-hover:border-brand-400 group-hover:shadow-sm group-hover:shadow-brand-500/50 ${i === 0 ? 'border-brand-400 shadow-sm shadow-brand-500/50' : ''}`}
            />

            <div class="rounded-2xl border border-white/8 bg-neutral-900/50 p-6 backdrop-blur-sm transition-all duration-300 hover:border-brand-500/20 hover:shadow-lg hover:shadow-brand-500/5">
              <div class="mb-3 flex flex-wrap items-start justify-between gap-3">
                <div>
                  <h3 class="text-base font-semibold text-white">{edu.title}</h3>
                  <p class="mt-0.5 text-sm font-medium text-brand-400">{edu.institution}</p>
                </div>
                <span class="flex-shrink-0 rounded-full border border-white/10 bg-white/5 px-3 py-1 text-xs font-medium text-neutral-500">
                  {edu.date}
                </span>
              </div>
              <p class="text-sm leading-6 text-neutral-400">{edu.description}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
