---
interface Props {
  config: {
    title: string;
    downloadButton: { text: string; file: string };
    description: { title: string; text: string };
  };
}

const { config } = Astro.props;
---

<section id="resume" class="scroll-mt-24 py-20">
  <!-- Section header -->
  <div class="mb-12">
    <p class="mb-2 text-xs font-semibold uppercase tracking-widest text-brand-400">My CV</p>
    <h2 class="text-3xl font-bold tracking-tight text-white md:text-4xl">{config.title}</h2>
  </div>

  <div
    class="relative overflow-hidden rounded-2xl border border-white/8 bg-neutral-900/50 p-8 backdrop-blur-sm md:p-10"
  >
    <!-- Background glow -->
    <div
      class="pointer-events-none absolute -right-16 -top-16 h-48 w-48 rounded-full bg-brand-500/10 blur-3xl"
    ></div>

    <div class="relative flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between">
      <div class="flex items-start gap-5">
        <div
          class="flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-xl bg-brand-500/15 ring-1 ring-brand-500/30"
        >
          <span class="material-symbols-outlined text-xl text-brand-400">description</span>
        </div>
        <div>
          <h3 class="mb-1 text-lg font-semibold text-white">{config.description.title}</h3>
          <p class="max-w-md text-sm leading-6 text-neutral-400">{config.description.text}</p>
        </div>
      </div>
      <a
        href={config.downloadButton.file}
        class="flex-shrink-0 inline-flex items-center gap-2 rounded-full bg-brand-500 px-7 py-3 text-sm font-semibold text-white shadow-lg shadow-brand-500/25 transition-all hover:bg-brand-600 hover:shadow-brand-500/40 hover:shadow-xl"
        onclick="event.preventDefault(); window.open(this.href);"
      >
        <span class="material-symbols-outlined text-base">download</span>
        {config.downloadButton.text}
      </a>
    </div>
  </div>
</section>
