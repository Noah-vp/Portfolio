---
interface Props {
  config: {
    profileImage: string;
    name: string;
    description: string[];
    primaryButton: { text: string; link: string };
    secondaryButton: { text: string; link: string };
  };
}

const { config } = Astro.props;
const [firstName, ...rest] = config.name.split(' ');
const lastName = rest.join(' ');
---

<section id="hero" class="flex min-h-[80vh] items-center py-16">
  <div
    class="flex w-full flex-col items-center gap-12 text-center md:flex-row md:items-center md:gap-16 md:text-left"
  >
    <!-- Profile image -->
    <div class="relative flex-shrink-0">
      <!-- Glow ring -->
      <div
        class="absolute -inset-2 rounded-full bg-gradient-to-br from-brand-400/40 via-brand-500/20 to-violet-500/20 blur-md"
      ></div>
      <div class="absolute -inset-0.5 rounded-full bg-gradient-to-br from-brand-400/60 to-brand-600/40">
      </div>
      <img
        src={config.profileImage}
        alt={`${config.name} profile photo`}
        class="relative h-44 w-44 rounded-full object-cover md:h-52 md:w-52"
        loading="eager"
      />
    </div>

    <!-- Text content -->
    <div class="flex-1">
      <!-- Name -->
      <h1 class="mb-5 text-5xl font-extrabold tracking-tight md:text-6xl lg:text-7xl">
        <span class="bg-gradient-to-r from-white via-neutral-100 to-neutral-400 bg-clip-text text-transparent">
          {firstName}
        </span>
        <br />
        <span class="bg-gradient-to-r from-brand-300 via-brand-400 to-brand-500 bg-clip-text text-transparent">
          {lastName}
        </span>
      </h1>

      <!-- Typewriter roles -->
      <div class="mb-8 flex justify-center md:justify-start">
        <p class="text-lg font-medium text-neutral-300">
          <span id="typewriter"></span><span id="cursor" class="ml-0.5 inline-block w-0.5 animate-pulse bg-brand-400 align-middle">&nbsp;</span>
        </p>
      </div>

      <script define:vars={{ roles: config.description }}>
        const el = document.getElementById('typewriter');
        let roleIndex = 0;
        let charIndex = 0;
        let deleting = false;
        const TYPE_SPEED = 55;
        const DELETE_SPEED = 30;
        const PAUSE = 2000;

        function tick() {
          const current = roles[roleIndex];
          if (!deleting) {
            el.textContent = current.slice(0, ++charIndex);
            if (charIndex === current.length) {
              deleting = true;
              setTimeout(tick, PAUSE);
              return;
            }
          } else {
            el.textContent = current.slice(0, --charIndex);
            if (charIndex === 0) {
              deleting = false;
              roleIndex = (roleIndex + 1) % roles.length;
            }
          }
          setTimeout(tick, deleting ? DELETE_SPEED : TYPE_SPEED);
        }

        tick();
      </script>

      <!-- CTA buttons -->
      <div class="flex flex-wrap justify-center gap-3 md:justify-start">
        <a
          href={config.primaryButton.link}
          class="group flex items-center gap-2 rounded-xl bg-brand-500 px-6 py-3 text-sm font-semibold text-white shadow-lg shadow-brand-500/20 transition-all duration-300 hover:bg-brand-600 hover:shadow-brand-500/30 hover:shadow-xl hover:-translate-y-px"
        >
          {config.primaryButton.text}
          <svg class="h-4 w-4 transition-transform duration-300 group-hover:rotate-90" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
        <a
          href={config.secondaryButton.link}
          class="group flex items-center gap-2 rounded-xl border border-white/15 bg-white/5 px-6 py-3 text-sm font-semibold text-neutral-300 backdrop-blur-sm transition-all duration-300 hover:border-white/25 hover:bg-white/10 hover:text-white hover:-translate-y-px"
        >
          {config.secondaryButton.text}
          <svg class="h-4 w-4 opacity-50 transition-all duration-300 group-hover:opacity-100 group-hover:rotate-90" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>
