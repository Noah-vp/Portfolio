---
interface ContactItem {
  type: string;
  label: string;
  value: string;
  link: string;
  icon: string;
}

interface Props {
  config: {
    title: string;
    contactInfo: ContactItem[];
    location: { city: string; description: string; note: string };
    message: string;
  };
}

const { config } = Astro.props;
---

<section id="contact" class="scroll-mt-24 py-20 pb-32">
  <!-- Section header -->
  <div class="mb-12">
    <p class="mb-2 text-xs font-semibold uppercase tracking-widest text-brand-400">Say hello</p>
    <h2 class="text-3xl font-bold tracking-tight text-white md:text-4xl">{config.title}</h2>
  </div>

  <!-- Message banner -->
  <div class="mb-6 overflow-hidden rounded-2xl border border-brand-500/20 bg-gradient-to-r from-brand-500/10 via-brand-500/5 to-transparent p-6 backdrop-blur-sm">
    <p class="text-base font-medium text-neutral-200">{config.message}</p>
  </div>

  <div class="grid gap-4 md:grid-cols-2">
    <!-- Contact links -->
    <div class="rounded-2xl border border-white/8 bg-neutral-900/50 p-6 backdrop-blur-sm">
      <h3 class="mb-5 text-xs font-semibold uppercase tracking-widest text-brand-400">
        Reach me at
      </h3>
      <ul class="flex flex-col gap-3">
        {
          config.contactInfo.map((item) => (
            <li>
              <a
                href={item.link}
                class="group flex items-center gap-3 rounded-xl p-3 transition-all duration-200 hover:bg-white/5"
                target={item.type !== 'email' ? '_blank' : undefined}
                rel={item.type !== 'email' ? 'noopener noreferrer' : undefined}
              >
                <span class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-xl bg-white/5 text-brand-400 ring-1 ring-white/10 transition-all group-hover:bg-brand-500/15 group-hover:ring-brand-500/30">
                  <span class="material-symbols-outlined text-lg">{item.icon}</span>
                </span>
                <div class="min-w-0 flex-1">
                  <p class="text-xs text-neutral-500">{item.label}</p>
                  <p class="truncate text-sm font-medium text-neutral-200 group-hover:text-white">
                    {item.value}
                  </p>
                </div>
                <svg
                  class="h-4 w-4 flex-shrink-0 text-neutral-600 transition-all group-hover:translate-x-0.5 group-hover:text-brand-400"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M9 5l7 7-7 7"
                  />
                </svg>
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <!-- Location -->
    <div class="flex flex-col gap-4">
      <div class="flex-1 rounded-2xl border border-white/8 bg-neutral-900/50 p-6 backdrop-blur-sm">
        <h3 class="mb-4 text-xs font-semibold uppercase tracking-widest text-brand-400">Location</h3>
        <div class="flex items-center gap-3">
          <img
            src="https://flagcdn.com/w40/nl.png"
            alt="Netherlands flag"
            class="h-6 w-8 flex-shrink-0 rounded object-cover"
            loading="lazy"
          />
          <div>
            <p class="text-sm font-semibold text-white">{config.location.city}</p>
            <p class="text-xs text-neutral-500">{config.location.description}</p>
          </div>
        </div>
        <p class="mt-4 text-sm leading-6 text-neutral-400">{config.location.note}</p>
      </div>

      <!-- Availability card -->
      <div class="rounded-2xl border border-emerald-500/20 bg-emerald-500/5 p-5 backdrop-blur-sm">
        <div class="flex items-center gap-2">
          <span class="h-2 w-2 animate-pulse rounded-full bg-emerald-400"></span>
          <p class="text-sm font-semibold text-emerald-300">Open to collaboration</p>
        </div>
        <p class="mt-2 text-xs leading-5 text-neutral-400">
          Building in public. Always happy to connect with founders, engineers, and curious people.
        </p>
      </div>
    </div>
  </div>
</section>
