---
interface Skill {
  name: string;
  experience?: string;
}

interface Category {
  title: string;
  skills: Skill[];
}

interface Props {
  config: {
    title: string;
    categories: Category[];
  };
}

const { config } = Astro.props;
---

<section id="skills" class="scroll-mt-24 py-20">
  <!-- Section header -->
  <div class="mb-12">
    <p class="mb-2 text-xs font-semibold uppercase tracking-widest text-brand-400">What I know</p>
    <h2 class="text-3xl font-bold tracking-tight text-white md:text-4xl">{config.title}</h2>
  </div>

  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {
      config.categories.map((category) => (
        <div class="group relative overflow-hidden rounded-2xl border border-white/8 bg-neutral-900/50 p-6 backdrop-blur-sm transition-all duration-300 hover:border-brand-500/20 hover:shadow-lg hover:shadow-brand-500/5">
          <!-- Top accent line -->
          <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-brand-500/50 to-transparent opacity-0 transition-opacity group-hover:opacity-100" />
          <h3 class="mb-4 text-xs font-semibold uppercase tracking-widest text-brand-400">
            {category.title}
          </h3>
          <div class="flex flex-wrap gap-2">
            {category.skills.map((skill) => (
              <button
                class="skill-chip rounded-full border border-white/10 bg-white/5 px-3 py-1.5 text-sm text-neutral-400 transition-all duration-200 hover:border-brand-500/40 hover:bg-brand-500/10 hover:text-brand-300"
                data-skill={JSON.stringify(skill)}
                type="button"
              >
                {skill.name}
              </button>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</section>

<!-- Skill popup -->
<div
  id="skill-overlay"
  class="fixed inset-0 z-50 hidden items-center justify-center bg-black/70 p-4 backdrop-blur-sm"
  role="dialog"
  aria-modal="true"
  aria-labelledby="skill-popup-title"
>
  <div
    id="skill-popup"
    class="relative mx-auto w-full max-w-md overflow-hidden rounded-2xl border border-white/10 bg-neutral-900 shadow-2xl"
    style="opacity:0;transform:scale(0.95) translateY(8px);transition:opacity 0.2s ease-out,transform 0.2s ease-out"
  >
    <!-- Top gradient bar -->
    <div class="h-px w-full bg-gradient-to-r from-transparent via-brand-500/50 to-transparent"></div>
    <div class="p-6">
      <button
        id="skill-popup-close"
        class="absolute right-4 top-4 rounded-lg p-1 text-neutral-500 transition-colors hover:bg-white/5 hover:text-white"
        aria-label="Close"
        type="button"
      >
        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
      <h3 id="skill-popup-title" class="mb-3 pr-8 text-xl font-semibold text-white"></h3>
      <p id="skill-popup-desc" class="text-sm leading-7 text-neutral-400"></p>
    </div>
  </div>
</div>

<script>
  const overlay = document.getElementById('skill-overlay')!;
  const popup = document.getElementById('skill-popup')!;
  const closeBtn = document.getElementById('skill-popup-close')!;
  const titleEl = document.getElementById('skill-popup-title')!;
  const descEl = document.getElementById('skill-popup-desc')!;

  function openPopup(skill: { name: string; experience?: string }) {
    titleEl.textContent = skill.name;
    descEl.textContent = skill.experience ?? 'No experience description available.';
    overlay.classList.remove('hidden');
    overlay.classList.add('flex');
    document.body.style.overflow = 'hidden';
    requestAnimationFrame(() => {
      popup.style.opacity = '1';
      popup.style.transform = 'scale(1) translateY(0)';
    });
  }

  function closePopup() {
    popup.style.opacity = '0';
    popup.style.transform = 'scale(0.95) translateY(8px)';
    setTimeout(() => {
      overlay.classList.add('hidden');
      overlay.classList.remove('flex');
    }, 200);
    document.body.style.overflow = '';
  }

  closeBtn.addEventListener('click', closePopup);
  overlay.addEventListener('click', (e) => {
    if (e.target === overlay) closePopup();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && overlay.classList.contains('flex')) closePopup();
  });

  document.querySelectorAll<HTMLButtonElement>('.skill-chip').forEach((chip) => {
    chip.addEventListener('click', () => {
      const skill = JSON.parse(chip.dataset.skill ?? '{}');
      openPopup(skill);
    });
  });
</script>
